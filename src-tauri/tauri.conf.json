{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Physics Tracker",
  "version": "2.0.0",
  "identifier": "com.crimsonvisa.physics-tracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Physics Tracker",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "focus": true,
        "backgroundColor": "#0e1319",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CrimsonVisa",
    "copyright": "Copyright © 2026 CrimsonVisa",
    "licenseFile": "../LICENSE",
    "category": "Education",
    "shortDescription": "Offline-first Windows study tracker for CSIR-UGC NET, GATE, TIFR and JEST Physics.",
    "longDescription": "A complete offline-first Windows study tracker for CSIR-UGC NET, GATE Physics, TIFR GS and JEST Physics: official-source syllabus progress, focus timer and sessions, checklist and calendar planning, PYQ and mock-test analytics, spaced-repetition revision scheduling, study insights, verified backup and restore, and CSV/JSON portability. All personal study data stays in a local SQLite database.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "legal/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md",
      "../legal/THIRD_PARTY_COVERAGE.md": "legal/THIRD_PARTY_COVERAGE.md",
      "../legal/README.md": "legal/README.md",
      "../legal/licenses": "legal/licenses",
      "../legal/notices": "legal/notices",
      "../public/fonts/NOTICE.txt": "legal/fonts/CMU-NOTICE.txt",
      "../public/fonts/OFL-1.1.txt": "legal/fonts/CMU-OFL-1.1.txt",
      "../src/assets/fonts/ui/inter/OFL.txt": "legal/fonts/Inter-OFL-1.1.txt",
      "../src/assets/fonts/ui/manrope/OFL.txt": "legal/fonts/Manrope-OFL-1.1.txt",
      "../src/assets/fonts/ui/ibm-plex-sans/OFL.txt": "legal/fonts/IBM-Plex-Sans-OFL-1.1.txt",
      "../src/assets/fonts/ui/plus-jakarta-sans/OFL.txt": "legal/fonts/Plus-Jakarta-Sans-OFL-1.1.txt",
      "../src/assets/fonts/ui/jetbrains-mono/OFL.txt": "legal/fonts/JetBrains-Mono-OFL-1.1.txt"
    },
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "template": "nsis/installer.nsi",
        "installMode": "currentUser",
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Physics Tracker"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
